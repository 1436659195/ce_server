# relay 启动配置 —— 复制本文件为 .env 并填写真实值。
# .env 不进 git(含密钥);本文件 .env.example 是模板,可进 git。
# 用法:cp .env.example .env && vi .env,然后 ./start.sh

# state 加密密钥(必填)。生产用强随机串,例如:
#   openssl rand -hex 32
# 不设则 relay-state.json 明文存 token(仅本地测试可接受)。
RELAY_STATE_KEY=

# 监听端口(默认 8606)。
RELAY_PORT=8606

# 对外中继地址(必填):install 脚本注入用它,防 Host 头伪造。
# 公网部署示例:ws://your.domain.com:8606
# 上了 TLS / 反代示例:wss://your.domain.com
RELAY_PUBLIC_URL=

# state 文件路径(可选,默认 ./relay-state.json)。一般不用改。
# RELAY_STATE=relay-state.json

# TLS 证书(可选,强烈建议生产配;两者都留空 → 明文 ws 启动)。
# 路径可相对仓库根,也可写绝对路径。
RELAY_TLS_CERT=
RELAY_TLS_KEY=
